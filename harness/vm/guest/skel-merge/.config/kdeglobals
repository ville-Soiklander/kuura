# Test-only keys MERGED (key by key, via kwriteconfig6) into the product's own
# /etc/skel/.config/kdeglobals; this file is never copied over it. WHY: the product
# (packages/kuura-shell) ships this file too, and a wholesale copy would erase its
# widgetStyle and LookAndFeelPackage keys. See harness/skelmerge.py.
[KDE]
AnimationDurationFactor=0
CursorBlinkRate=0
# Plasma's own default-browser key (KDE reads [General] BrowserApplication besides
# the XDG mimeapps.list in guest/skel); pinned for the same reason: the image also has
# the verification-only chromium and the shelf's browser launcher must not flip.
[General]
BrowserApplication=firefox.desktop
