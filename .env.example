# Working codename of the distribution; used in package and repository names.
DISTRO_NAME=kuura

# Container engine used for reproducible builds (podman or docker).
CONTAINER_ENGINE=podman

# Arch Linux Archive snapshot date (YYYY/MM/DD) that pins every package version.
ARCH_ARCHIVE_DATE=2026/09/24

# Output directory of the signed package repository, relative to the project root.
REPO_DIR=.build/repo

# Fingerprint of the repository signing key. The private key is never stored here.
GPG_KEY_ID=
