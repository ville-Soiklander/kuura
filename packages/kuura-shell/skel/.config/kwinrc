# NOTE: the file actually installed to /etc/skel/.config/kwinrc on a real system has
# ONE MORE section than what you see below. packages/kuura-shell/PKGBUILD's own
# package() step appends a generated [Effect-slidingpopups] fragment (SlideInTime/
# SlideOutTime, derived from design/tokens.json's motion.duration.fast) to this
# file's content at package-build time - see design/generators/kwin_motion.py's
# module docstring for the full reasoning (the one real, non-approximated motion-
# token lever this project wires into KWin config) and docs/SHELL_CONTRACT.md's
# "Animation curves (motion tokens)" section for the live-verification trail. This
# file on disk in the repository intentionally stays static and does not carry that
# section itself.
#
# Window decoration, titlebar-button placement, corner style and Overview-effect
# tuning for new users of the desktop shell (V3 of the working brief). Installed to
# /etc/skel/.config/kwinrc by the kuura-shell package (docs/SHELL_CONTRACT.md), so a
# brand-new account picks it up on first login, the same way harness/vm/guest/skel
# ships a (separate, test-only) kwinrc for the screenshot harness.
#
# WHY these specific keys and no others: found by booting the pinned guest image
# (kwin 6.7.5-1, kdecoration 6.7.5-1, breeze 6.7.5-1 - confirmed with
# `pacman -Q kwin kdecoration breeze` in the guest) and testing each one live with
# `kwriteconfig6 --file kwinrc ...` followed by
# `qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure`, screenshotting before/after.
# Nothing here is a guessed key name - see the V3 investigation notes handed back
# with this change for the full trail (commands run, exact output, screenshots).
#
# ---- Window buttons on the left [org.kde.kdecoration2] ----
# The layout keys are read from the decoration settings group
# (/usr/share/config.kcfg/kwindecorationsettings.kcfg: group org.kde.kdecoration2,
# keys ButtonsOnLeft / ButtonsOnRight). An earlier revision wrote them under [Windows],
# which KWin never reads, so KDE's default layout stayed in force (2026-10-20).
# Letters are KDecoration's standard button codes: X=close, I=minimize, A=maximize.
# Order is left to right: close, minimize, maximize. The right side is empty and no
# application-menu (M) button is listed, because the project's visual language has none.
#
# ---- Round "traffic-light" buttons: our own C++ decoration plugin (same group) ----
# The stock decoration cannot change button shape or colour, so the desktop ships its own
# KDecoration3 plugin (packages/kuura-decoration, pulled in by kuura-desktop). It replaced
# an earlier Aurorae QML theme because QML cannot round the BOTTOM window corners; the C++
# plugin can (setBorderRadius), and it draws its own shadow and buttons from the design
# tokens.
#   library = plugin id of that plugin: DISTRO_NAME + ".decoration". The product-name
#             placeholder inside the value is substituted by the package build
#             (packages/kuura-shell/PKGBUILD) with DISTRO_NAME.
# No `theme=` key: that key only selects a theme inside the Aurorae engine; a plugin with
# a single look needs none.
# If the plugin fails to load, KWin falls back to Breeze (the [Windeco] group below then
# applies), so a broken plugin never leaves windows without a title bar.
# ONE look for both colour modes: the plugin reads title-bar and caption colours from the
# active colour scheme at run time, so switching the scheme restyles it with no further
# step (docs/SHELL_CONTRACT.md, "Window decoration").
#
# ---- Border size (same group) ----
# KWin 6.7.5 still uses this LEGACY group name (not a new "kdecoration3" one) for the
# decoration's border-size choice - confirmed live: the "Window Decorations" KCM
# writes exactly this key when a preset other than its own top entry is picked.
# BorderSizeAuto=false selects the explicit "Normal window borders" preset instead of
# the KCM's default entry, labelled "Theme default (No window borders)" (see the
# CAVEAT below - this entry's name is a real, visible symptom of the open issue).
#
# ---- Corner rounding [Windeco] (stock Breeze decoration only) ----
# Our own decoration plugin rounds all four corners from radius.window; this group is
# read only by Breeze and is kept as the fallback if the plugin is unavailable.
# RoundedCorners is the ONLY corner-radius lever the stock Breeze decoration exposes.
# Confirmed by scanning the compiled decoration plugin and its KCM
# (kcm_breezedecoration.so, org.kde.breeze.so) for every config-key-shaped string:
# "roundedCorners"/"RoundedCorners" and "ShadowStrength" exist; there is NO numeric
# pixel-radius key and NO material/inner-shadow key anywhere in either binary.
# This boolean only toggles Breeze's own small, fixed corner radius (a few px) on or
# off - it CANNOT reach design/tokens.json's radius.window=14 or the
# material.inner_shadow values; that is why the own plugin above exists.
# RoundedCorners=true is kept because it is the correct, zero-cost choice for the
# Breeze fallback.
#
# ---- Resolved caveat (2026-10-20) ----
# Earlier revisions reported that no key here changed the rendered titlebar. The cause
# was the button layout written under [Windows], a group KWin does not read. With the
# keys in [org.kde.kdecoration2] the screenshot harness shows close and minimize on the
# left. The maximize button is absent in the harness because its window rules fix the
# window size (inference from harness/vm/guest/skel/.config/kwinrulesrc, see
# docs/SHELL_CONTRACT.md).
[org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=
library=@NAME@.decoration
BorderSizeAuto=false

[Windeco]
RoundedCorners=true

# ---- No crossfade on a colour scheme switch [Plugins] ----
# blendchanges (enabled by default) crossfades from a snapshot of the old screen when the
# colour scheme changes. If the shell recolours a panel while that crossfade runs, KWin
# sometimes never repaints the panel afterwards: it keeps the old icons and glass tint
# until something else repaints it (a minute or more for the shelf). Found and measured
# in the screenshot harness on 2026-10-21: 6 of 32 light switches left a stale panel with
# the effect loaded, 0 of 18 with it unloaded (docs/HARNESS_CONTRACT.md). The switch
# itself stays; only the soft fade is lost. <id>Enabled is KWin's standard per-effect key.
[Plugins]
blendchangesEnabled=false

# ---- Overview effect tuning [Effect-overview] ----
# This is the real, confirmed config group: kwriteconfig6 writes to it and
# `cat kwinrc` reads the value straight back after a reconfigure (unlike the
# decoration case above, this one round-trips cleanly). The effect's own KCM plugin
# (kwin_overview_config.so) was scanned the same way as Breeze's and exposes exactly
# two settings - IgnoreMinimized and OrganizedGrid - nothing else. There is NO
# spacing/gap/margin key and NO per-effect animation-duration or easing-curve key for
# Overview anywhere in this build. The only animation-speed lever in the whole
# desktop is kdeglobals' global AnimationDurationFactor, which is a unitless
# multiplier applied to every effect's own hard-coded duration - it is not the same
# kind of value as design/tokens.json's motion.duration.base (260, an absolute
# millisecond count) or motion.easing_standard (a cubic-bezier curve), and mapping
# either onto it would be an approximation dressed up as a real mapping. Per the
# brief's own instruction not to approximate, neither token is used here.
# OrganizedGrid=true is the one genuine, verified layout/spacing lever the effect
# exposes (thumbnails arrange on a clean grid instead of a free-form layout - this is
# the closest real equivalent to a "spacing" control that this effect actually has).
# IgnoreMinimized=true hides minimized windows from the overview, a sensible default
# that was already very likely KWin's own compiled default (this pins it explicitly).
[Effect-overview]
IgnoreMinimized=true
OrganizedGrid=true
