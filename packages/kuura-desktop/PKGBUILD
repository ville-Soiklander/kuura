# Metapackage that turns a base Arch installation into the desktop of the
# distribution. It ships no files of its own: installing it only pulls in the
# packages listed in `depends`, so the desktop is defined in exactly one place.
#
# The package name comes from the environment (DISTRO_NAME, see .env.example) so
# that the codename is configured once. makepkg is run through build/build_repo.sh,
# which exports the variable; building by hand without it fails with a clear error.

pkgname="${DISTRO_NAME:?DISTRO_NAME must be set}-desktop"
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop metapackage: KDE Plasma session with Wayland, audio, network and fonts"
arch=('any')
url='https://github.com/ville-Soiklander/kuura'
# Themes, configuration and scripts of the project are GPL-3.0-or-later (see LICENSE
# and docs/LICENSES/README.md).
license=('GPL-3.0-or-later')

# Scope is fixed by docs/BUILD_CONTRACT.md: Plasma session, KWin compositor,
# display manager, file manager, terminal, Kvantum, audio and network applets,
# Wayland support and the two font packages. Extend the contract before this list.
depends=(
    # MUST stay first. Several Plasma packages need a `jack` provider, and pacman
    # resolves `depends` depth first in list order, so whichever provider is reached
    # first wins. Listed later, the unrelated jack2 server was picked and then
    # conflicted with pipewire-jack (found by `make verify-install`).
    'pipewire-jack'
    # Plasma session and compositor
    'plasma-desktop'
    'kwin'
    'kscreen'
    'powerdevil'
    # Display manager, themed with this monorepo's own SDDM greeter (Vaihe 6,
    # built from the same DISTRO_NAME variable as this package's own name;
    # real-boot verified 2026-10-01, see packages/kuura-sddm/PKGBUILD's own
    # "VERIFIED LIVE" comment).
    'sddm'
    "${DISTRO_NAME}-sddm"
    # Applications
    'dolphin'
    'konsole'
    # Browser: Firefox with a preinstalled, token-themed profile and about:config
    # defaults (Vaihe 6, a package of this monorepo) - built from the same
    # DISTRO_NAME variable as this package's own name. Note for future packages
    # of this monorepo: kuura-firefox's own depends already lists pipewire-jack
    # first for the same jack-provider-ordering reason this array's own leading
    # entry does (see packages/kuura-firefox/PKGBUILD's own comment for the real,
    # reproduced conflict this defends against) - any FUTURE local package whose
    # own dependency tree can also reach a "jack" virtual dependency needs the
    # same defensive entry, this is not automatically inherited from here.
    "${DISTRO_NAME}-firefox"
    # Theme engine
    'kvantum'
    # Cursor theme - a variant of KDE Breeze cursors styled after this
    # project's own visual language (the default KDE would otherwise pull in
    # transitively via kwin -> breeze -> breeze-cursors, which stays fine too
    # but gives no distinct look); see docs/ASSETS.md.
    'capitaine-cursors'
    # Own-production icon set, wallpapers and UI sounds (Vaihe 5, a package of
    # this monorepo, docs/ASSETS.md's own-production note) - built from the
    # same DISTRO_NAME variable as this package's own name.
    "${DISTRO_NAME}-assets"
    # Desktop shell theming (panel layout, KWin tuning, shortcuts, Kvantum/GTK4
    # theme) - a package of this monorepo (packages/kuura-shell/PKGBUILD), so its
    # name is built from the same DISTRO_NAME variable as this package's own name
    # instead of being a literal string like the entries above (docs/SHELL_CONTRACT.md:
    # "installed by kuura-desktop (added to its depends)").
    "${DISTRO_NAME}-shell"
    # Shutdown/logout confirmation dialog, a Plasma Look-and-Feel KPackage
    # (Vaihe 6, a package of this monorepo) - real-boot verified 2026-10-01
    # (ksmserver-logout-greeter --windowed under Xvfb), see
    # packages/kuura-lookandfeel/PKGBUILD's own comment for the full detail.
    # Activated via kdeglobals, not this depends list alone - see
    # packages/kuura-shell/skel/.config/kdeglobals's own LookAndFeelPackage
    # comment.
    "${DISTRO_NAME}-lookandfeel"
    # Audio and network applets
    'plasma-nm'
    'plasma-pa'
    'pipewire-pulse'
    # Wayland support and desktop portal integration
    'xdg-desktop-portal-kde'
    'qt6-wayland'
    # Fonts
    'inter-font'
    'ttf-jetbrains-mono'
)
