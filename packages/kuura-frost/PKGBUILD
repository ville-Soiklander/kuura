# Frost: the desktop shell's glass "material" KWin compositor effect (Vaihe 4
# of the working brief). Unlike kuura-desktop/kuura-shell, this package compiles
# real, ABI-sensitive native code against the pinned Arch snapshot's own KWin
# headers/CMake package config (packages/kuura-frost/CMakeLists.txt's own
# comments record exactly which real build failures made each makedepends
# below necessary -- nothing here is a guessed toolchain list).
#
# src/frost.h is the locked interface/contract for the effect; src/frost.cpp
# implements it in full, including the real refraction/specular-highlight/
# dither-noise material shader (src/frost_shader.h) -- see frost.h's own
# apply() docstring for the locked mathematical specification this
# implements, and packages/kuura-frost/tests/offscreen_shader_test.cpp for
# the headless correctness test that verifies it against hand-computed
# per-pixel values.
#
# The package name comes from the environment (DISTRO_NAME, see .env.example),
# the same convention as kuura-desktop/kuura-shell; building by hand without it
# fails with a clear error. makepkg is run through build/build_repo.sh, which
# exports the variable.

pkgname="${DISTRO_NAME:?DISTRO_NAME must be set}-frost"
pkgver=0.1.0
pkgrel=9
pkgdesc="Glass 'material' KWin compositor effect (background blur reuse, edge refraction, specular highlight, dither noise)"
# Unlike kuura-desktop/kuura-shell (arch=('any'): pure config/scripts), this
# package compiles a native .so against KWin's C++ effect ABI, which is NOT
# stable across versions (frost.h's class docstring) -- it is tied to exactly
# the pinned snapshot's kwin/qt6-base/kcoreaddons, hence a real architecture.
arch=('x86_64')
url='https://github.com/ville-Soiklander/kuura'
# GPL-2.0-or-later, unlike the project's GPL-3.0-or-later default: this is a
# KWin effect plugin that links against KWin's own GPL-2.0-or-later code, so it
# is licensed for compatibility with KWin (distro-tyonkulku.md 1.6; see also
# LICENSES/README.md). GPL-2.0-or-later is an SPDX id covered by Arch's
# `licenses` package, so no licence text needs to be installed.
license=('GPL-2.0-or-later')
# kwin: the compositor this plugin loads into at runtime (metadata.json is
# read by KWin's own effect loader; the compiled .so is installed under its
# plugin search path -- see package() below).
depends=('kwin')
# Real C++ toolchain needed to configure+build the CMake project below --
# see packages/kuura-frost/CMakeLists.txt's own comments for exactly why each
# one is required (each was confirmed by a real failing build first, not
# assumed in advance):
#   extra-cmake-modules   KDEInstallDirs/KDECMakeSettings, ECM_GLOBAL_FIND_VERSION
#   cmake, ninja           the build system itself (kcoreaddons_add_plugin's
#                          MODULE branch needs CMAKE_LIBRARY_OUTPUT_DIRECTORY,
#                          which KDECMakeSettings supplies)
#   qt6-base               Qt6::Core/Gui/Widgets -- KWin::kwin's own exported
#                          CMake target links Qt6::Widgets even though this
#                          effect draws nothing with it directly
#   kwin                   the effect headers and KWin::kwin/KWin package
#                          config this plugin builds against
#   kcoreaddons            kcoreaddons_add_plugin(), the real out-of-tree
#                          KWin effect plugin registration macro
#   vulkan-headers         KWin::kwin's own exported target pulls in Vulkan
#                          headers transitively (confirmed by a real build
#                          failure before this was added)
# python: build() now also runs design/generate.py through its `python -m`
# CLI (Vaihe 4's real material shader reads design/tokens.json's material.*
# values as generated constexpr C++ constants, see
# design/generators/cpp_header.py -- frost.h's own class docstring forbids
# hand-copying those numbers as shader-source/C++ literals instead). Standard
# library only on the design.generate side (see that module's own docstring),
# so no further makedepends beyond the interpreter itself -- the same
# reasoning packages/kuura-shell/PKGBUILD's own makedepends comment already
# gives for its identical 'python' entry.
# NOTE on kdecoration (KDecoration3 headers, CMakeLists.txt's own
# find_package(KDecoration3)): NOT listed separately here -- confirmed live
# (`pacman -Qi kwin`) that the pinned kwin package's own "Depends On" list
# already includes kdecoration directly, so makepkg's --syncdeps installs it
# transitively via the 'kwin' entry below; adding it again explicitly would
# only duplicate an already-guaranteed dependency, not fix a real gap.
makedepends=('extra-cmake-modules' 'cmake' 'ninja' 'qt6-base' 'kwin' 'kcoreaddons' 'vulkan-headers' 'python'
             'mesa' 'libglvnd')

# build(): generates the real material.* C++ header from design/tokens.json,
# THEN configures and builds the CMake project in place. The design.generate
# invocation below copies packages/kuura-shell/PKGBUILD's own build() step in
# form (same PROJECT_ROOT-via-three-"..".-from-$srcdir navigation, since this
# PKGBUILD sits at the exact same depth, packages/<name>/PKGBUILD) -- only the
# --out-dir target differs: "$srcdir/../generated" (a sibling of the checked-in
# src/ directory, i.e. packages/kuura-frost/generated/), matching the fixed,
# conventional location CMakeLists.txt's own target_include_directories() call
# now reads <tokens.h> from (${CMAKE_CURRENT_SOURCE_DIR}/generated/cpp --
# CMAKE_CURRENT_SOURCE_DIR being "$srcdir/.." here, so "generated/cpp" under it
# is exactly "$srcdir/../generated/cpp"). kuura-frost's own CMakeLists.txt and
# src/ already sit directly next to this PKGBUILD -- one level below $srcdir
# (makepkg's own auto-created build directory, empty here since there is no
# source= to extract into it), so `cd "$srcdir/.."` reaches them, the same
# relative-navigation idiom kuura-shell's build() already uses.
build() {
    ( cd "$srcdir/../../.." && python3 -m design.generate \
        --out-dir "$srcdir/../generated" --name "$DISTRO_NAME" )

    ( cd "$srcdir/.." && cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
        && cmake --build build )
}

# check(): runs the headless shader-correctness test (tests/offscreen_shader_test.cpp)
# against the same frost_shader.h and generated tokens.h the shipped plugin uses, so a
# token or shader change that breaks the hand-computed per-pixel expectations fails the
# package build instead of shipping. It is configured in a SEPARATE build directory
# (build-test) with KUURA_FROST_BUILD_TESTS=ON so the shipped build/ tree never needs
# EGL/GL (mesa is a makedepends entry for the test only). The build container has no
# display and no GPU: EGL_PLATFORM=surfaceless plus LIBGL_ALWAYS_SOFTWARE=1 force Mesa's
# llvmpipe rasteriser, which is also deterministic across hosts.
check() {
    cd "$srcdir/.."
    cmake -S . -B build-test -G Ninja -DKUURA_FROST_BUILD_TESTS=ON
    cmake --build build-test --target kuura_frost_offscreen_shader_test
    EGL_PLATFORM=surfaceless LIBGL_ALWAYS_SOFTWARE=1 \
        ./build-test/bin/kuura_frost_offscreen_shader_test
}

# package(): installs the just-built plugin (.so + metadata.json) via CMake's
# own install() rules (kcoreaddons_add_plugin's INSTALL_NAMESPACE, see
# CMakeLists.txt) into $pkgdir, exactly as `cmake --install` would onto a real
# system -- nothing here re-derives the install path by hand.
package() {
    ( cd "$srcdir/.." && DESTDIR="$pkgdir" cmake --install build )
}
