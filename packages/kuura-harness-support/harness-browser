#!/usr/bin/env bash
# harness-browser - open the fixed local test page in a fresh browser profile.
#
# Shipped on the real product (packages/kuura-harness-support) so that the
# `browser-window` state of harness/install/run.py's diff-pass has a real, present
# target to run on a Calamares-installed system, not just on the screenshot harness's
# own pre-baked test image. The logic below is byte-identical to that image's own
# copy (harness/vm/guest/overlay/usr/local/bin/harness-browser) - keep the two in sync,
# since the goldens this script's output is compared against were captured against
# exactly this behaviour. Never invoked by anything in a normal desktop session; the
# real end-user browser is Firefox itself (packages/kuura-firefox), launched normally.
#
# WHY a wrapper: the state must not depend on anything a previous launch left behind.
# Every start therefore copies the profile template (preferences that switch off first-run
# pages, updates, telemetry and restore prompts) into a NEW empty profile directory below
# the session's runtime directory (a RAM disk on the test image; tmpfs or disk here,
# removed at logout either way), and --no-remote keeps the browser from attaching to an
# instance that already runs.
#
# Usage: harness-browser [FILE]
#   FILE  absolute path of a local file to open (default: the fixed sample page)

set -euo pipefail

# Directory with the profile template and the sample page (this package's own files).
readonly SHARE_DIR="/usr/local/share/harness"
# Window size in logical pixels; must equal the size in the browser rule of kwinrulesrc.
readonly WINDOW_WIDTH=1000
readonly WINDOW_HEIGHT=600

# die MESSAGE...  Error message on stderr and non-zero exit.
die() { printf 'harness-browser: error: %s\n' "$*" >&2; exit 1; }

# main ARGS...
# Validates the optional file argument, prepares a fresh profile and replaces this
# process with the browser.
main() {
    [ "$#" -le 1 ] || die "usage: harness-browser [FILE]"
    local page="${1:-$SHARE_DIR/browser-page.html}"
    # The path becomes part of a file:// URL, so only plain absolute paths are accepted.
    [[ "$page" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "FILE must be a plain absolute path"
    [ -f "$page" ] || die "FILE does not exist"
    [ -f "$SHARE_DIR/firefox-profile/user.js" ] || die "profile template is missing"

    local base="${XDG_RUNTIME_DIR:-/tmp}"
    local profile
    profile="$(mktemp -d "$base/harness-browser.XXXXXX")"
    cp -- "$SHARE_DIR/firefox-profile/user.js" "$profile/user.js"

    # --width/--height: the window size in logical pixels. The window rule of the
    # session (kwinrulesrc) fixes the position and asks for the same size, but this
    # browser does not follow a size that is forced from outside, so it is given here.
    exec firefox --no-remote --profile "$profile" --width "$WINDOW_WIDTH" --height "$WINDOW_HEIGHT" \
        --new-window "file://$page"
}

main "$@"
