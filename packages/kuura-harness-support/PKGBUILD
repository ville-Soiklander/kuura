# Ships the real-product copies of three files that the screenshot harness's own
# pre-baked test image (harness/vm/) already carries: the harness-browser wrapper
# script, the static test page it opens, and the throwaway browser profile template
# it creates on every start. Needed so that harness/install/run.py's diff-pass (a real
# Calamares install, not the test image) has something real to run for the
# `browser-window` state - see docs/ISO_CONTRACT.md's "Installed-system verification"
# section for the decision this package implements (project owner's explicit choice,
# `AskUserQuestion`, 2026-10-15: ship this as-is rather than excluding the state).
#
# SEPARATE PACKAGE, NOT folded into kuura-desktop - that package's own header
# comment says it "ships no files of its own" (depends only), and NOT folded into
# kuura-firefox either, even though this is Firefox-adjacent tooling: this package's
# own user.js is scoped to harness-browser's own throwaway profile only and must
# stay independent of kuura-firefox's real, system-wide policies.json (see below).
#
# NOT a reach-across-the-repo build-time copy from harness/vm/guest/overlay/: that
# would require staging the whole harness/ tree (including multi-MB golden PNGs)
# into the package-build container (build/Containerfile's own COPY list) just to
# reach three small files. These three files are instead maintained here as their
# own copies, kept in sync by hand - each one's own header comment says so and
# names its sibling. The window-size/profile/page CONTENT in all three is
# byte-identical to the test image's own copies on purpose: the goldens this
# install-verify diff-pass compares against were captured against exactly that
# content, so any drift here would show up as a false pixel-diff regression that
# has nothing to do with the real product.
#
# DELIBERATELY DOES NOT touch packages/kuura-firefox/PKGBUILD's own policies.json
# (project owner's explicit choice, `AskUserQuestion`, 2026-10-15): that file is
# system-wide (/usr/lib/firefox/distribution/policies.json, owned by kuura-firefox)
# and deliberately lighter than what the test image's own harness-only policies.json
# would set (it does not disable telemetry, Pocket, Firefox Accounts or the
# password manager for a real end user). Only this package's own user.js - scoped to
# harness-browser's own throwaway profile, never a real user's actual Firefox
# profile - ships here. A real install's browser-window screenshot can therefore be
# marginally less deterministic than the test image's (e.g. a password-save prompt
# could in theory appear) purely because of this; that is the accepted cost of not
# changing every real user's actual Firefox privacy/feature defaults just to serve
# this harness.
#
# The package name comes from the environment (DISTRO_NAME, see .env.example), the
# same convention every other package of this monorepo uses.

pkgname="${DISTRO_NAME:?DISTRO_NAME must be set}-harness-support"
pkgver=0.1.0
pkgrel=1
pkgdesc="Install-verify support: the browser-window state's helper script, test page and browser profile"
arch=('any')
url='https://github.com/ville-Soiklander/kuura'
# This package's own files (the script, the page, the profile template) are
# GPL-3.0-or-later (see LICENSE and docs/LICENSES/README.md), matching every other
# package of this monorepo.
license=('GPL-3.0-or-later')
# firefox: the real browser harness-browser launches with a throwaway profile.
# Already pulled in transitively by kuura-firefox, but declared directly here too -
# this package's own harness-browser script calls `firefox` on its own, independent
# of whichever other package happens to also depend on it.
depends=('firefox')

# package(): installs this package's own three files (see this PKGBUILD's own header
# comment for why they are maintained here rather than reached across the repo) to
# the same real, confirmed paths the test image's own copies use
# (harness/vm/Containerfile's own COPY guest/overlay/ /), so that
# harness/install/wizard.py's `run_install`/`log_into_sddm` and the reused
# harness/shots/runner.py Runner (via harness/install/run.py) find exactly what they
# expect on a real Calamares-installed target.
package() {
    install -Dm755 "$srcdir/../harness-browser" \
        "$pkgdir/usr/local/bin/harness-browser"
    install -Dm644 "$srcdir/../browser-page.html" \
        "$pkgdir/usr/local/share/harness/browser-page.html"
    install -Dm644 "$srcdir/../user.js" \
        "$pkgdir/usr/local/share/harness/firefox-profile/user.js"
}
